{
    "name": "stefandoorn/sylius-seo-url-plugin",
    "type": "sylius-plugin",
    "keywords": ["sylius", "sylius-plugin"],
    "description": "SEO URLs for Sylius",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "sylius/sylius": "^2.2"
    },
    "require-dev": {
        "behat/behat": "^3.16",
        "behat/mink": "^1.13",
        "behat/mink-selenium2-driver": "^1.7",
        "dbrekelmans/bdi": "^1.4",
        "dmore/behat-chrome-extension": "^1.4",
        "dmore/chrome-mink-driver": "^2.9",
        "friends-of-behat/mink-browserkit-driver": "^1.6",
        "friends-of-behat/mink-debug-extension": "^2.1",
        "friends-of-behat/mink-extension": "^2.7",
        "friends-of-behat/suite-settings-extension": "^1.1",
        "friends-of-behat/symfony-extension": "^2.6",
        "friends-of-behat/variadic-extension": "^1.6",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.5",
        "sylius-labs/coding-standard": "^4.4",
        "sylius/sylius-rector": "^2.0",
        "sylius/test-application": "^2.0.0@alpha",
        "symfony/browser-kit": "^6.4 || ^7.4",
        "symfony/debug-bundle": "^6.4 || ^7.4",
        "symfony/dotenv": "^6.4 || ^7.4",
        "symfony/http-client": "^6.4 || ^7.4",
        "symfony/intl": "^6.4 || ^7.4",
        "symfony/runtime": "^6.4 || ^7.4",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4",
        "symfony/webpack-encore-bundle": "^2.2",
        "friends-of-behat/page-object-extension": "^0.3"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "StefanDoorn\\SyliusSeoUrlPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\StefanDoorn\\SyliusSeoUrlPlugin\\": ["tests/", "tests/TestApplication/src/"]
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false,
            "symfony/flex": true,
            "symfony/runtime": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        },
        "symfony": {
            "require": "^6.4"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "scripts": {
        "database-reset": [
            "vendor/bin/console doctrine:database:drop --force --if-exists",
            "vendor/bin/console doctrine:database:create",
            "vendor/bin/console doctrine:migrations:migrate -n",
            "vendor/bin/console sylius:fixtures:load -n"
        ],
        "frontend-clear": [
            "cd vendor/sylius/test-application && yarn install && yarn build",
            "vendor/bin/console assets:install"
        ],
        "test-app-init": [
            "@database-reset",
            "@frontend-clear"
        ],
        "ecs": "ecs",
        "phpstan": "phpstan analyse",
        "phpunit": "phpunit",
        "behat": "behat --strict -vvv --no-interaction || behat --strict -vvv --no-interaction --rerun",
        "suite": [
            "@ecs",
            "@phpstan",
            "@phpunit",
            "@behat"
        ],
        "post-install-cmd": ["@create-console-symlink"],
        "post-update-cmd": ["@create-console-symlink"],
        "create-console-symlink": ["@php bin/create_console_symlink.php"]
    }
}
